# Copy this file to ".env" and fill in your real values.
# ".env" is git-ignored on purpose - it holds secrets and must never
# be committed or pushed to GitHub.

# Get a free key at https://openweathermap.org/api (takes ~2 minutes)
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# MySQL connection details
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=weather_app

# Flask
FLASK_SECRET_KEY=change_this_to_any_random_string
FLASK_DEBUG=True
